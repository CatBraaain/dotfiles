{
  "name": "pi-sessions",
  "displayName": "Pi Sessions",
  "description": "Browse Pi (pi-coding-agent) sessions in the sidebar and open them in editor terminals.",
  "version": "0.1.0",
  "publisher": "pi-sessions",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piSessionViews",
          "title": "Agent Sessions",
          "icon": "media/agent-sessions.svg"
        }
      ]
    },
    "views": {
      "piSessionViews": [
        {
          "id": "piSessions.sessions",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.client.json",
    "screenshot": "npm run build && node scripts/screenshot.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && npm run storybook:build && vitest run",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@storybook/html-vite": "^10.6.0",
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "eslint": "^9.0.0",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
