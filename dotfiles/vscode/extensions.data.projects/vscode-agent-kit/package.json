{
  "name": "pi-sessions",
  "displayName": "Pi Sessions",
  "version": "0.1.0",
  "private": true,
  "description": "Browse Pi (pi-coding-agent) sessions in the sidebar and open them in editor terminals.",
  "categories": [
    "Other"
  ],
  "license": "UNLICENSED",
  "publisher": "pi-sessions",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "vp pack && vp build",
    "fix": "vp check --fix && prettier --plugin=prettier-markdown-table --parser markdown --write \"**/*.md\"",
    "setup": "node scripts/setup.mjs",
    "test": "bun run build && bun run storybook:build && vp test",
    "test:e2e": "bun run build && xvfb-run -a playwright test",
    "vsix": "bun run build && bunx @vscode/vsce package --allow-missing-repository --skip-license --no-dependencies && code --install-extension pi-sessions-0.1.0.vsix --force",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.85.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "prettier-markdown-table": "^1.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.0",
    "vite-plus": "^1.5.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "piSessionViews",
          "title": "Pi Sessions",
          "icon": "media/pi-sessions.svg"
        }
      ]
    },
    "views": {
      "piSessionViews": [
        {
          "id": "piSessions.sessions",
          "name": "Sessions",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workbench.action.terminal.sendSequence",
        "args": {
          "text": "\u001b[13;2u"
        },
        "key": "shift+enter",
        "when": "terminalFocus"
      }
    ]
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
