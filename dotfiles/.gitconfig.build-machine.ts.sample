async function main(): Promise<void> {
  const { buildHookContext } = await import(
    `${process.env.DOTFILES_MANAGER_SRC}/hook-context.ts`,
  );
  const { transform } = await buildHookContext();
  await transform(".gitconfig", (content: string) => `${content}
[user]
name = USERNAME
email = xxxxxxxxxx+USERNAME@users.noreply.github.com # https://github.com/settings/emails
`);
}

if (import.meta.main) await main();
