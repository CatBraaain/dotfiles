#!/usr/bin/env bun
import { $ } from "bun";
import { spawn } from "node:child_process";
import { closeSync, openSync } from "node:fs";
import { connect } from "node:net";

await Promise.allSettled([indexDeja(), updatePi(), startCamoufox(), startOpenserp()]);
process.exit(0);

async function indexDeja() {
  const deja = Bun.which("deja");
  if (deja) startDetached(deja, ["index"]);
}

async function updatePi() {
  const pi = Bun.which("pi");
  const flock = Bun.which("flock");
  if (!pi || !flock) return;

  const lock = `${process.env.TMPDIR || "/tmp"}/pi-update.lock`;
  // flock owns the lock until pi exits, independently of this startup process.
  startDetached(flock, ["-n", lock, pi, "update", "--all"]);
}

async function startCamoufox() {
  const cli = `${process.env.HOME}/.agents/cli/browse`;
  const bun = Bun.which("bun");
  if (!bun || !(await Bun.file(`${cli}/package.json`).exists())) return;

  const url = new URL(process.env.CAMOUFOX_BASE_URL || "ws://127.0.0.1:9378/camoufox");
  const host = url.hostname.replace(/^\[|\]$/g, "");
  const port = Number(url.port || (url.protocol === "wss:" ? "443" : "80"));
  if (await portOpen(host, port)) return;

  const logDir = `${process.env.XDG_CACHE_HOME || `${process.env.HOME}/.cache`}/pi/web-search`;
  await $`mkdir -p ${logDir}`.quiet();
  const log = openSync(`${logDir}/camoufox-server.log`, "a");
  try {
    startDetached(bun, [cli, "server", "start"], log);
  } finally {
    closeSync(log);
  }
}

async function startOpenserp() {
  const openserp = Bun.which("openserp");
  if (!openserp) return;

  const baseUrl = process.env.OPENSERP_BASE_URL || "http://127.0.0.1:7000";
  if (await httpHealthy(`${baseUrl}/ready`)) return;

  const url = new URL(baseUrl);
  const host = url.hostname.replace(/^\[|\]$/g, "");
  const port = url.port || (url.protocol === "https:" ? "443" : "80");
  startDetached(openserp, ["serve", "-a", host, "-p", port, "--quiet"]);
}

function startDetached(command: string, args: string[], output: number | "ignore" = "ignore") {
  const child = spawn(command, args, {
    detached: true,
    stdio: ["ignore", output, output],
  });
  child.on("error", () => {});
  child.unref();
}

function portOpen(host: string, port: number): Promise<boolean> {
  return new Promise((resolve) => {
    const socket = connect(port, host);
    socket.once("connect", () => {
      socket.destroy();
      resolve(true);
    });
    socket.once("error", () => resolve(false));
  });
}

async function httpHealthy(url: string): Promise<boolean> {
  try {
    const response = await fetch(url, {
      redirect: "manual",
      signal: AbortSignal.timeout(1000),
    });
    await response.arrayBuffer();
    // curl -fsS accepts redirects without following them, but fails on 4xx/5xx.
    return response.status < 400;
  } catch {
    return false;
  }
}
