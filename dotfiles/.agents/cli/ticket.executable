#!/usr/bin/env bun
// ticket CLI — human/agent interface for the markdown ticket store.
// Spec: dotfiles/.agents/cli/ticket.spec.md

import { execFileSync } from "node:child_process";
import { randomUUID } from "node:crypto";
import { link, mkdir, readdir, readFile, rename, rm, writeFile } from "node:fs/promises";
import { homedir } from "node:os";
import { basename, join, relative } from "node:path";

const STATUSES = ["draft", "open", "blocked", "locked", "closed", "cancelled"] as const;
type Status = (typeof STATUSES)[number];

const USAGE = `usage: ticket list [-s <s>[,<s>...]] [-p <project>] [-a] [--json]
       ticket show [<selector>] [-p <project>] [--json]
       ticket create <json> [-p <project>] [-o <owner>] [--json]
       ticket set [<selector>] <json> [-p <project>] [-o <owner>] [--json]
       ticket edit [<selector>] <old> <new> [-p <project>] [-o <owner>] [--json]
       ticket check [-p <project>] [-a] [--json]`;

interface Flags {
  project?: string;
  owner?: string;
  all: boolean;
  json: boolean;
  statuses: string[];
}

interface Ticket {
  id: string;
  status: Status;
  after: string | null;
  owner: string | null;
  title: string;
  path: string;
  project: string;
  body: string;
  content: string;
}

interface Issue {
  file: string;
  kind: "invalid-frontmatter" | "invalid-status" | "missing-after" | "after-cycle";
  detail: string;
}

interface FrontmatterPatch {
  status?: Status;
  after?: string | null;
  owner?: string | null;
}

interface TransactionChange {
  path: string;
  oldContent: string;
  newContent: string;
}

interface TransactionJournal {
  state: "prepared" | "committed";
  changes: Array<Pick<TransactionChange, "path" | "oldContent">>;
}

class TicketError extends Error {
  constructor(
    readonly code: 1 | 2,
    message: string,
  ) {
    super(message);
  }
}

const ALLOWED_FLAGS: Record<string, { all?: boolean; statuses?: boolean; json?: boolean; owner?: boolean }> = {
  list: { all: true, statuses: true, json: true },
  show: { json: true },
  create: { json: true, owner: true },
  set: { json: true, owner: true },
  edit: { json: true, owner: true },
  check: { all: true, json: true },
};

const storeRoot = () => join(homedir(), ".agents", "tickets");

function fail(message: string): never {
  throw new TicketError(1, message);
}

function usageFail(): never {
  throw new TicketError(2, USAGE);
}

function output(value: unknown): void {
  console.log(JSON.stringify(value, null, 2));
}

function parseArgs(argv: string[], command: string): { flags: Flags; positional: string[] } {
  const allowed = ALLOWED_FLAGS[command];
  if (!allowed) usageFail();
  const flags: Flags = { all: false, json: false, statuses: [] };
  const positional: string[] = [];
  let optionsEnded = false;
  for (let index = 0; index < argv.length; index++) {
    const arg = argv[index]!;
    const value = () => {
      const next = argv[++index];
      if (next === undefined || next.startsWith("-")) usageFail();
      return next;
    };
    if (optionsEnded) positional.push(arg);
    else if (arg === "--") optionsEnded = true;
    else if (arg === "-p" || arg === "--project") flags.project = value();
    else if (arg === "-o" || arg === "--owner") {
      if (!allowed.owner) usageFail();
      flags.owner = value();
    } else if (arg === "-a" || arg === "--all") {
      if (!allowed.all) usageFail();
      flags.all = true;
    } else if (arg === "-s" || arg === "--status") {
      if (!allowed.statuses) usageFail();
      flags.statuses = value().split(",");
    } else if (arg === "--json") {
      if (!allowed.json) usageFail();
      flags.json = true;
    } else if (arg.startsWith("-")) usageFail();
    else positional.push(arg);
  }
  return { flags, positional };
}

function validateStatus(status: string): Status {
  if (!(STATUSES as readonly string[]).includes(status)) {
    fail(`invalid status "${status}" (one of: ${STATUSES.join(", ")})`);
  }
  return status as Status;
}

function validateProject(project: string): string {
  if (!project || project === "." || project === ".." || project.includes("/") || project.includes("\\")) {
    fail(`invalid project: ${project}`);
  }
  return project;
}

function projectDir(project: string): string {
  return join(storeRoot(), validateProject(project));
}

function frontmatterIssue(content: string): string | null {
  if (!content.startsWith("---\n")) return "no frontmatter";
  const closing = content.indexOf("\n---\n", 4);
  if (closing < 0) return "unclosed frontmatter";
  const seen = new Set<string>();
  for (const line of content.slice(4, closing).split("\n")) {
    const pair = line.match(/^([A-Za-z_-]+):\s*(.*)$/);
    if (!pair) continue;
    const key = pair[1]!;
    if (["status", "after", "owner"].includes(key) && seen.has(key)) return `duplicate ${key} field`;
    seen.add(key);
  }
  if (!seen.has("status")) return "no status field";
  return null;
}

function splitFrontmatter(content: string): { frontmatter: string; fields: Map<string, string>; rest: string } {
  const closing = content.indexOf("\n---\n", 4);
  const frontmatter = content.slice(0, closing);
  const fields = new Map<string, string>();
  for (const line of frontmatter.slice(4).split("\n")) {
    const pair = line.match(/^([A-Za-z_-]+):\s*(.*)$/);
    if (pair) fields.set(pair[1]!, pair[2]!.trim());
  }
  return { frontmatter, fields, rest: content.slice(closing) };
}

function parseTicket(path: string, project: string, id: string, content: string): Ticket {
  const broken = frontmatterIssue(content);
  if (broken) fail(`${relative(storeRoot(), path)}: ${broken}`);
  const { fields, rest } = splitFrontmatter(content);
  const status = validateStatus(fields.get("status") ?? "");
  const owner = fields.get("owner") || null;
  if (status === "locked" && owner === null) fail(`${relative(storeRoot(), path)}: locked ticket has no owner`);
  const body = rest.slice("\n---\n".length);
  return {
    id,
    status,
    after: fields.get("after") || null,
    owner,
    title: body.match(/^# (.+)$/m)?.[1]?.trim() ?? id,
    path,
    project,
    body,
    content,
  };
}

async function loadTickets(project: string, collect?: Issue[]): Promise<Ticket[]> {
  const dir = projectDir(project);
  let names: string[];
  try {
    names = (await readdir(dir)).filter((name) => name.endsWith(".md")).sort();
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === "ENOENT") fail(`project not found: ${dir}`);
    throw error;
  }
  const tickets: Ticket[] = [];
  for (const name of names) {
    const id = name.slice(0, -3);
    const path = join(dir, name);
    try {
      tickets.push(parseTicket(path, project, id, await readFile(path, "utf8")));
    } catch (error) {
      if (collect && error instanceof TicketError) {
        collect.push({
          file: relative(storeRoot(), path),
          kind: error.message.includes("invalid status") ? "invalid-status" : "invalid-frontmatter",
          detail: error.message.split(": ").at(-1)!,
        });
        continue;
      }
      throw error;
    }
  }
  return tickets;
}

async function allProjects(): Promise<string[]> {
  try {
    const entries = await readdir(storeRoot(), { withFileTypes: true });
    return entries.filter((entry) => entry.isDirectory()).map((entry) => entry.name).sort();
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === "ENOENT") fail(`ticket store not found: ${storeRoot()}`);
    throw error;
  }
}

function isActionable(ticket: Ticket, byId: Map<string, Ticket>): boolean {
  return ticket.status === "open" && (ticket.after === null || byId.get(ticket.after)?.status === "closed");
}

function resolveSelector(tickets: Ticket[], selector: string | undefined): Ticket {
  if (selector === "") usageFail();
  if (selector === undefined || selector === "next") {
    const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
    const first = tickets.find((ticket) => isActionable(ticket, byId));
    if (!first) fail("no actionable ticket");
    return first;
  }
  const exact = tickets.find((ticket) => ticket.id === selector);
  if (exact) return exact;
  const matches = tickets.filter((ticket) => ticket.id.startsWith(selector));
  if (matches.length === 1) return matches[0]!;
  if (matches.length > 1) fail(`ambiguous id "${selector}": ${matches.map((ticket) => ticket.id).join(", ")}`);
  fail(`ticket not found: ${selector}`);
}

function resolveAfter(tickets: Ticket[], after: string): Ticket {
  if (after === "next") fail("after cannot be next");
  return resolveSelector(tickets, after);
}

function ticketJson(ticket: Ticket, withProject: boolean): Record<string, unknown> {
  const json: Record<string, unknown> = {
    id: ticket.id,
    status: ticket.status,
    after: ticket.after,
    title: ticket.title,
    path: ticket.path,
  };
  if (withProject) json.project = ticket.project;
  return json;
}

function defaultProject(): string {
  const cwd = process.cwd();
  try {
    const porcelain = execFileSync("git", ["worktree", "list", "--porcelain"], {
      cwd,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    });
    const mainPath = porcelain.match(/^worktree (.+)$/m)?.[1];
    if (mainPath !== undefined) return validateProject(basename(mainPath.trim()));
  } catch {
    // Fall through when cwd is not inside a Git worktree.
  }
  return validateProject(basename(cwd));
}

function resolveProject(flags: Flags): string {
  return validateProject(flags.project ?? defaultProject());
}

function timestamp(date: Date): string {
  const pad = (value: number) => String(value).padStart(2, "0");
  return `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}-${pad(date.getHours())}${pad(date.getMinutes())}${pad(date.getSeconds())}`;
}

function parseJsonObject(raw: string): Record<string, unknown> {
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw);
  } catch {
    usageFail();
  }
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) usageFail();
  return parsed as Record<string, unknown>;
}

function mergeFrontmatter(frontmatter: string, patch: FrontmatterPatch): string {
  const lines = frontmatter.split("\n");
  const replace = (key: "status" | "after" | "owner", value: string | null | undefined) => {
    if (value === undefined) return;
    const index = lines.findIndex((line) => line.startsWith(`${key}:`));
    if (value === null) {
      if (index >= 0) lines.splice(index, 1);
    } else if (index >= 0) {
      lines[index] = `${key}: ${value}`;
    } else {
      const statusIndex = lines.findIndex((line) => line.startsWith("status:"));
      lines.splice(statusIndex + 1, 0, `${key}: ${value}`);
    }
  };
  replace("status", patch.status);
  replace("after", patch.after);
  replace("owner", patch.owner);
  return lines.join("\n");
}

function createsCycle(targetId: string, after: string, byId: Map<string, Ticket>): boolean {
  let current: string | null = after;
  for (let steps = 0; current !== null && steps <= byId.size; steps++) {
    if (current === targetId) return true;
    current = byId.get(current)?.after ?? null;
  }
  return false;
}

function linkedStatus(target: Ticket, patch: FrontmatterPatch): Status {
  if (patch.status !== undefined) return patch.status;
  if (patch.after === undefined) return target.status;
  if (patch.after !== null) return "blocked";
  return target.status === "blocked" ? "open" : target.status;
}

function requireOwner(owner: string | undefined): string {
  if (!owner) fail("locked ticket updates require --owner");
  return owner;
}

function assertOwner(target: Ticket, owner: string | undefined): void {
  if (target.status !== "locked") return;
  if (target.owner === null) fail(`${target.id}: locked ticket has no owner`);
  if (target.owner !== owner) fail(`${target.id}: ticket is locked by another owner`);
}

async function acquireProjectLock(dir: string): Promise<() => Promise<void>> {
  const path = join(dir, ".ticket.lock");
  const deadline = Date.now() + 5_000;
  while (true) {
    try {
      await mkdir(path);
      return async () => rm(path, { recursive: true, force: true });
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
      if (Date.now() >= deadline) fail(`timed out waiting for ticket store lock: ${dir}`);
      await Bun.sleep(10);
    }
  }
}

async function recoverTransaction(dir: string): Promise<void> {
  const path = join(dir, ".ticket-transaction.json");
  let journal: TransactionJournal;
  try {
    journal = JSON.parse(await readFile(path, "utf8")) as TransactionJournal;
  } catch (error) {
    if ((error as NodeJS.ErrnoException).code === "ENOENT") return;
    throw error;
  }
  if (journal.state === "prepared") {
    for (const change of journal.changes) await writeFile(change.path, change.oldContent);
  }
  await rm(path, { force: true });
}

function injectTestFailure(step: string): void {
  if (process.env.TICKET_TEST_FAIL_STEP?.split(",").includes(step)) {
    throw new Error(`injected I/O failure at ${step}`);
  }
}

async function applyChanges(dir: string, changes: TransactionChange[]): Promise<void> {
  const changed = changes.filter((change) => change.oldContent !== change.newContent);
  if (changed.length === 0) return;
  const journalPath = join(dir, ".ticket-transaction.json");
  const journal: TransactionJournal = {
    state: "prepared",
    changes: changed.map(({ path, oldContent }) => ({ path, oldContent })),
  };
  const tempPaths: string[] = [];
  const renamed: TransactionChange[] = [];
  try {
    await writeFile(journalPath, JSON.stringify(journal), { flag: "wx" });
    for (const change of changed) {
      const tempPath = `${change.path}.ticket-${process.pid}-${randomUUID()}`;
      tempPaths.push(tempPath);
      await writeFile(tempPath, change.newContent, { flag: "wx" });
    }
    for (const [index, change] of changed.entries()) {
      injectTestFailure(`rename:${index}`);
      await rename(tempPaths[index]!, change.path);
      renamed.push(change);
    }
    await writeFile(journalPath, JSON.stringify({ ...journal, state: "committed" } satisfies TransactionJournal));
    await rm(journalPath);
  } catch (error) {
    for (const [index, change] of renamed.reverse().entries()) {
      injectTestFailure(`rollback:${index}`);
      await writeFile(change.path, change.oldContent);
    }
    throw error;
  } finally {
    await Promise.all(tempPaths.map((path) => rm(path, { force: true })));
  }
}

async function withProjectWrite<T>(
  project: string,
  operation: (dir: string) => Promise<T>,
  createProject = false,
): Promise<T> {
  const dir = projectDir(project);
  if (createProject) await mkdir(dir, { recursive: true });
  else {
    try {
      await readdir(dir);
    } catch (error) {
      if ((error as NodeJS.ErrnoException).code === "ENOENT") fail(`project not found: ${dir}`);
      throw error;
    }
  }
  const release = await acquireProjectLock(dir);
  try {
    await recoverTransaction(dir);
    return await operation(dir);
  } finally {
    await release();
  }
}

async function listCommand(flags: Flags): Promise<void> {
  for (const status of flags.statuses) validateStatus(status);
  const projects = flags.all ? await allProjects() : [resolveProject(flags)];
  const tickets = (await Promise.all(projects.map((project) => loadTickets(project)))).flat();
  const filtered = flags.statuses.length > 0
    ? tickets.filter((ticket) => flags.statuses.includes(ticket.status))
    : tickets.filter((ticket) => ticket.status === "open");
  if (flags.json) return output(filtered.map((ticket) => ticketJson(ticket, flags.all)));
  for (const ticket of filtered) console.log(`${flags.all ? `${ticket.project}\t` : ""}${ticket.id}\t${ticket.status}\t${ticket.title}`);
}

async function showCommand(positional: string[], flags: Flags): Promise<void> {
  if (positional.length > 1) usageFail();
  const ticket = resolveSelector(await loadTickets(resolveProject(flags)), positional[0]);
  if (flags.json) return output({ ...ticketJson(ticket, false), body: ticket.body });
  console.log(`${ticket.id}\nstatus: ${ticket.status}\nafter: ${ticket.after ?? "-"}\n`);
  console.log(ticket.body.trimEnd());
}

interface CreateInput {
  title: string;
  status?: Status;
  after?: string;
  body?: string;
}

function parseCreateInput(raw: string | undefined): CreateInput {
  if (raw === undefined) usageFail();
  const parsed = parseJsonObject(raw);
  if (Object.keys(parsed).some((key) => !["title", "status", "after", "body"].includes(key))) usageFail();
  if (typeof parsed.title !== "string") usageFail();
  const input: CreateInput = { title: parsed.title };
  if (parsed.status !== undefined) {
    if (typeof parsed.status !== "string") usageFail();
    input.status = validateStatus(parsed.status);
  }
  if (parsed.after !== undefined) {
    if (typeof parsed.after !== "string") usageFail();
    input.after = parsed.after;
  }
  if (parsed.body !== undefined) {
    if (typeof parsed.body !== "string") usageFail();
    input.body = parsed.body;
  }
  return input;
}

async function createCommand(positional: string[], flags: Flags): Promise<void> {
  if (positional.length !== 1) usageFail();
  const input = parseCreateInput(positional[0]);
  const project = resolveProject(flags);
  const ticket = await withProjectWrite(project, async (dir) => {
    const tickets = await loadTickets(project);
    let after: string | null = null;
    if (input.after !== undefined && input.after !== null) {
      const dependency = resolveAfter(tickets, input.after);
      if (dependency.status === "closed" || dependency.status === "cancelled") {
        fail(`after references unavailable ticket: ${dependency.id}`);
      }
      after = dependency.id;
    }
    const status = input.status ?? (after === null ? "open" : "blocked");
    const owner = status === "locked" ? requireOwner(flags.owner) : null;
    const frontmatter = ["---", `status: ${status}`, ...(after ? [`after: ${after}`] : []), ...(owner ? [`owner: ${owner}`] : []), "---"].join("\n");
    const body = input.body === undefined ? `# ${input.title}\n` : `# ${input.title}\n\n${input.body}\n`;
    let date = new Date();
    while (true) {
      const id = timestamp(date);
      const path = join(dir, `${id}.md`);
      const temporaryPath = join(dir, `.ticket-new-${process.pid}-${randomUUID()}`);
      try {
        const content = `${frontmatter}\n${body}`;
        await writeFile(temporaryPath, content, { flag: "wx" });
        await link(temporaryPath, path);
        return { id, status, after, owner, title: input.title, path, project, body, content } satisfies Ticket;
      } catch (error) {
        if ((error as NodeJS.ErrnoException).code !== "EEXIST") throw error;
        date = new Date(date.getTime() + 1_000);
      } finally {
        await rm(temporaryPath, { force: true });
      }
    }
  }, true);
  if (flags.json) return output(ticketJson(ticket, false));
  console.log(ticket.id);
}

function parseSetInput(raw: string | undefined): FrontmatterPatch {
  if (raw === undefined) usageFail();
  const parsed = parseJsonObject(raw);
  const keys = Object.keys(parsed);
  if (keys.length === 0) usageFail();
  const patch: FrontmatterPatch = {};
  for (const key of keys) {
    if (key === "status") {
      if (typeof parsed.status !== "string") usageFail();
      patch.status = validateStatus(parsed.status);
    } else if (key === "after") {
      if (parsed.after !== null && typeof parsed.after !== "string") usageFail();
      patch.after = parsed.after;
    } else {
      usageFail();
    }
  }
  return patch;
}

async function setCommand(positional: string[], flags: Flags): Promise<void> {
  if (positional.length < 1 || positional.length > 2) usageFail();
  const [selector, jsonArg] = positional.length === 1 ? [undefined, positional[0]!] : [positional[0]!, positional[1]!];
  const patch = parseSetInput(jsonArg);
  const project = resolveProject(flags);
  const updated = await withProjectWrite(project, async (dir) => {
    const tickets = await loadTickets(project);
    const target = resolveSelector(tickets, selector);
    assertOwner(target, flags.owner);
    const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
    let after = patch.after;
    if (after !== undefined && after !== null) {
      const dependency = resolveAfter(tickets, after);
      if (dependency.status === "closed" || dependency.status === "cancelled") fail(`after references unavailable ticket: ${dependency.id}`);
      if (createsCycle(target.id, dependency.id, byId)) fail(`setting after would create a cycle: ${target.id} -> ${dependency.id}`);
      after = dependency.id;
    }
    const nextStatus = linkedStatus(target, { ...patch, after });
    const owner = nextStatus === "locked"
      ? target.status === "locked" ? target.owner : requireOwner(flags.owner)
      : null;
    const targetParts = splitFrontmatter(target.content);
    const targetContent = `${mergeFrontmatter(targetParts.frontmatter, { status: nextStatus, after, owner })}${targetParts.rest}`;
    const changes: TransactionChange[] = [{ path: target.path, oldContent: target.content, newContent: targetContent }];
    if (patch.status === "closed") {
      for (const dependent of tickets) {
        if (dependent.status !== "blocked" || dependent.after !== target.id) continue;
        const parts = splitFrontmatter(dependent.content);
        changes.push({
          path: dependent.path,
          oldContent: dependent.content,
          newContent: `${mergeFrontmatter(parts.frontmatter, { status: "open" })}${parts.rest}`,
        });
      }
    }
    await applyChanges(dir, changes);
    return { ...target, status: nextStatus, after: after === undefined ? target.after : after, owner, content: targetContent };
  });
  if (flags.json) return output(ticketJson(updated, false));
  if (patch.status !== undefined) console.log(updated.status);
  else if (patch.after !== undefined && (patch.after !== null || updated.status === "open")) console.log(updated.status);
}

async function editCommand(positional: string[], flags: Flags): Promise<void> {
  if (positional.length < 2 || positional.length > 3) usageFail();
  const [selector, old, replacement] = positional.length === 2
    ? [undefined, positional[0]!, positional[1]!]
    : [positional[0]!, positional[1]!, positional[2]!];
  if (!old || replacement === undefined) usageFail();
  const project = resolveProject(flags);
  const updated = await withProjectWrite(project, async (dir) => {
    const target = resolveSelector(await loadTickets(project), selector);
    assertOwner(target, flags.owner);
    let matches = 0;
    let cursor = target.body.indexOf(old);
    while (cursor >= 0) {
      matches++;
      cursor = target.body.indexOf(old, cursor + old.length);
    }
    if (matches !== 1) fail(`${target.id}: "${old}" appears ${matches} times in the body\nCurrent body:\n${target.body}`);
    const body = target.body.replace(old, replacement);
    const { frontmatter } = splitFrontmatter(target.content);
    const content = `${frontmatter}\n---\n${body}`;
    await applyChanges(dir, [{ path: target.path, oldContent: target.content, newContent: content }]);
    return { ...target, body, content, title: body.match(/^# (.+)$/m)?.[1]?.trim() ?? target.id };
  });
  if (flags.json) output(ticketJson(updated, false));
}

function findCycles(tickets: Ticket[]): string[][] {
  const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
  const state = new Map<string, number>();
  const stack: string[] = [];
  const cycles: string[][] = [];
  const seen = new Set<string>();
  const visit = (id: string): void => {
    const visited = state.get(id) ?? 0;
    if (visited === 2) return;
    if (visited === 1) {
      const cycle = stack.slice(stack.indexOf(id));
      const key = [...cycle].sort().join("|");
      if (!seen.has(key)) {
        seen.add(key);
        cycles.push(cycle);
      }
      return;
    }
    state.set(id, 1);
    stack.push(id);
    const after = byId.get(id)?.after;
    if (after !== null && after !== undefined && byId.has(after)) visit(after);
    stack.pop();
    state.set(id, 2);
  };
  for (const ticket of tickets) visit(ticket.id);
  return cycles;
}

async function checkCommand(flags: Flags): Promise<void> {
  const projects = flags.all ? await allProjects() : [resolveProject(flags)];
  const issues: Issue[] = [];
  for (const project of projects) {
    const tickets = await loadTickets(project, issues);
    const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
    for (const ticket of tickets) {
      if (ticket.after !== null && !byId.has(ticket.after)) {
        issues.push({ file: relative(storeRoot(), ticket.path), kind: "missing-after", detail: `after references missing ticket: ${ticket.after}` });
      }
    }
    for (const cycle of findCycles(tickets)) {
      const head = byId.get(cycle[0]!)!;
      issues.push({ file: relative(storeRoot(), head.path), kind: "after-cycle", detail: `after cycle: ${cycle.join(" -> ")}` });
    }
  }
  if (flags.json) output(issues);
  else if (issues.length === 0) console.log("ok");
  else for (const issue of issues) console.log(`${issue.file}: ${issue.kind}: ${issue.detail}`);
  if (issues.length > 0) process.exitCode = 1;
}

function hasJsonFlag(argv: string[]): boolean {
  for (const arg of argv) {
    if (arg === "--") return false;
    if (arg === "--json") return true;
  }
  return false;
}

async function main(): Promise<void> {
  const [command = "", ...argv] = process.argv.slice(2);
  const { flags, positional } = parseArgs(argv, command);
  switch (command) {
    case "list": return listCommand(flags);
    case "show": return showCommand(positional, flags);
    case "create": return createCommand(positional, flags);
    case "set": return setCommand(positional, flags);
    case "edit": return editCommand(positional, flags);
    case "check": return checkCommand(flags);
    default: return usageFail();
  }
}

try {
  await main();
} catch (error) {
  const failure = error instanceof TicketError ? error : new TicketError(1, `I/O error: ${(error as Error).message}`);
  const jsonMode = hasJsonFlag(process.argv.slice(2));
  const errorMessage = jsonMode ? failure.message.replace(/\r?\n/g, "\\n") : failure.message;
  if (jsonMode) output({ error: errorMessage });
  console.error(errorMessage);
  process.exitCode = failure.code;
}
