#!/usr/bin/env bun
// ticket CLI — human/agent interface for the markdown ticket store.
// Spec: dotfiles/.agents/cli/ticket.spec.md

import { execFileSync } from "node:child_process";
import { readdir, readFile, writeFile } from "node:fs/promises";
import { homedir } from "node:os";
import { basename, join, relative } from "node:path";

const STATUSES = ["draft", "open", "blocked", "locked", "closed", "cancelled"] as const;
type Status = (typeof STATUSES)[number];

const USAGE = `usage: ticket list [--status <s>[,<s>...]] [--project <p>] [--all] [--json]
       ticket show <id> [--project <p>] [--json]
       ticket status <id> <status> [--project <p>]
       ticket create <title> [--status <s>] [--depends-on <id>[,<id>...]] [--body <text>] [--project <p>] [--json]
       ticket update <id> [--metadata <json>] [--body <text>] [--project <p>] [--json]
       ticket check [--project <p>] [--all] [--json]`;

interface Flags {
  project?: string;
  all: boolean;
  json: boolean;
  statuses: string[];
  status?: string;
  dependsOn?: string[];
  body?: string;
  metadata?: string;
}

interface Ticket {
  id: string;
  status: string;
  title: string;
  dependsOn: string[];
  path: string;
  project: string;
  body: string;
}

interface Issue {
  file: string;
  kind: string;
  detail: string;
}

type CommonFields = Pick<Ticket, "id" | "status" | "title" | "dependsOn" | "path" | "project">;

type FrontmatterPatch = { status?: Status; dependsOn?: string[] };

// timestamp part of an ID, e.g. "20260917-180315"
const ID_TIMESTAMP_LENGTH = "YYYYMMDD-HHMMSS".length;

const ALLOWED_FLAGS: Record<string, { all?: boolean; statuses?: boolean; status?: boolean; dependsOn?: boolean; body?: boolean; metadata?: boolean; json?: boolean }> = {
  list: { all: true, statuses: true, json: true },
  show: { json: true },
  status: {},
  create: { status: true, dependsOn: true, body: true, json: true },
  update: { metadata: true, body: true, json: true },
  check: { all: true, json: true },
};

const storeRoot = () => join(homedir(), ".agents", "tickets");

function fail(message: string): never {
  console.error(message);
  process.exit(1);
}

function output(value: unknown): void {
  console.log(JSON.stringify(value, null, 2));
}

function parseArgs(argv: string[], command: string): { flags: Flags; positional: string[] } {
  if (!(command in ALLOWED_FLAGS)) fail(USAGE);
  const allowed = ALLOWED_FLAGS[command]!;
  const flags: Flags = { all: false, json: false, statuses: [] };
  const positional: string[] = [];
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]!;
    const value = () => argv[++i] ?? fail(`${arg} requires a value`);
    if (arg === "--json" && allowed.json) flags.json = true;
    else if (arg === "--project") flags.project = value();
    else if (arg === "--all" && allowed.all) flags.all = true;
    else if (arg === "--status" && allowed.statuses) flags.statuses = value().split(",");
    else if (arg === "--status" && allowed.status) flags.status = value();
    else if (arg === "--depends-on" && allowed.dependsOn) flags.dependsOn = value().split(",");
    else if (arg === "--body" && allowed.body) flags.body = value();
    else if (arg === "--metadata" && allowed.metadata) flags.metadata = value();
    else if (arg.startsWith("--")) fail(`unknown flag for "${command}": ${arg}`);
    else positional.push(arg);
  }
  return { flags, positional };
}

function parseFrontmatter(content: string): { fields: Map<string, string | string[]>; body: string } {
  if (!content.startsWith("---\n")) return { fields: new Map(), body: content };
  const closing = content.indexOf("\n---\n", 4);
  if (closing < 0) return { fields: new Map(), body: content };
  const fields = new Map<string, string | string[]>();
  let key = "";
  for (const line of content.slice(4, closing).split("\n")) {
    const item = line.match(/^  - (.+)$/);
    if (key && item) {
      const list = fields.get(key);
      if (Array.isArray(list)) list.push(item[1].trim());
      continue;
    }
    const pair = line.match(/^([A-Za-z_-]+):\s*(.*)$/);
    if (pair) {
      key = pair[1]!;
      fields.set(key, pair[2] === "" ? [] : pair[2].trim());
    } else {
      key = "";
    }
  }
  return { fields, body: content.slice(closing + 5) };
}

async function loadTickets(project: string): Promise<Ticket[]> {
  const dir = join(storeRoot(), project);
  let ids: string[];
  try {
    ids = (await readdir(dir))
      .map((name) => (name.endsWith(".md") ? name.slice(0, -3) : null))
      .filter((id): id is string => id !== null)
      .sort();
  } catch {
    fail(`project not found: ${dir}`);
  }
  const tickets: Ticket[] = [];
  for (const id of ids!) {
    const path = join(dir, `${id}.md`);
    const { fields, body } = parseFrontmatter(await readFile(path, "utf8"));
    const deps = fields.get("depends_on");
    tickets.push({
      id,
      status: String(fields.get("status") ?? ""),
      title: body.match(/^# (.+)$/m)?.[1]?.trim() ?? id,
      dependsOn: Array.isArray(deps) ? deps : deps ? [String(deps)] : [],
      path,
      project,
      body,
    });
  }
  return tickets;
}

async function allProjects(): Promise<string[]> {
  try {
    const entries = await readdir(storeRoot(), { withFileTypes: true });
    return entries.filter((entry) => entry.isDirectory()).map((entry) => entry.name).sort();
  } catch {
    return fail(`ticket store not found: ${storeRoot()}`);
  }
}

function resolveId(tickets: Ticket[], id: string): Ticket {
  const exact = tickets.find((ticket) => ticket.id === id);
  if (exact) return exact;
  const matches = tickets.filter((ticket) => ticket.id.startsWith(id));
  if (matches.length === 1) return matches[0]!;
  if (matches.length > 1) {
    fail(`ambiguous id "${id}":\n${matches.map((ticket) => `  ${ticket.id}`).join("\n")}`);
  }
  fail(`ticket not found: ${id}`);
}

function validateStatus(status: string): Status {
  if (!STATUSES.includes(status as Status)) fail(`invalid status "${status}" (one of: ${STATUSES.join(", ")})`);
  return status as Status;
}

// Splits validated frontmatter from the rest; the caller must handle the errors first.
function splitFrontmatter(content: string, path: string): { frontmatter: string; rest: string } {
  if (!content.startsWith("---\n")) fail(`no frontmatter: ${path}`);
  const closing = content.indexOf("\n---\n", 4);
  if (closing < 0) fail(`unclosed frontmatter: ${path}`);
  const frontmatter = content.slice(0, closing);
  if (!/^status:.*$/m.test(frontmatter)) fail(`no status field: ${path}`);
  return { frontmatter, rest: content.slice(closing) };
}

function mergeFrontmatter(frontmatter: string, patch: FrontmatterPatch): string {
  const lines = frontmatter.split("\n");
  const statusIndex = lines.findIndex((line) => line.startsWith("status:"));
  if (patch.status !== undefined) lines[statusIndex] = `status: ${patch.status}`;
  if (patch.dependsOn !== undefined) {
    const rendered = ["depends_on:", ...patch.dependsOn.map((dep) => `  - ${dep}`)];
    const depIndex = lines.findIndex((line) => line.startsWith("depends_on:"));
    if (depIndex < 0) {
      lines.splice(statusIndex + 1, 0, ...rendered);
    } else {
      let listEnd = depIndex + 1;
      while (listEnd < lines.length && lines[listEnd]!.startsWith("  - ")) listEnd++;
      lines.splice(depIndex, listEnd - depIndex, ...rendered);
    }
  }
  return lines.join("\n");
}

// rest starts with "\n---\n"; replaces everything after the H1 heading, keeping it.
function replaceBody(rest: string, body: string): string {
  const content = rest.slice("\n---\n".length);
  const h1 = content.match(/^# (.+)$/m);
  const updated = h1 ? `# ${h1[1]!.trim()}\n\n${body}` : body;
  return `\n---\n${updated.trimEnd()}\n`;
}

function ticketJson(ticket: CommonFields, withProject: boolean): Record<string, unknown> {
  const json: Record<string, unknown> = {
    id: ticket.id,
    status: ticket.status,
    title: ticket.title,
    depends_on: ticket.dependsOn,
    path: ticket.path,
  };
  if (withProject) json.project = ticket.project;
  return json;
}

// git worktree list lists the main worktree first; fall back to the cwd name
// when cwd is not inside a git repo or git is unavailable.
function defaultProject(): string {
  const cwd = process.cwd();
  try {
    const porcelain = execFileSync("git", ["worktree", "list", "--porcelain"], {
      cwd,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    });
    const mainPath = porcelain.match(/^worktree (.+)$/m)?.[1];
    if (mainPath !== undefined) return basename(mainPath.trim());
  } catch {
    // fall through to the cwd name
  }
  return basename(cwd);
}

function resolveProject(flags: Flags): string {
  return flags.project ?? defaultProject();
}

function timestamp(date: Date): string {
  const pad = (value: number) => String(value).padStart(2, "0");
  return `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}-${pad(date.getHours())}${pad(date.getMinutes())}${pad(date.getSeconds())}`;
}

function toSlug(title: string): string {
  return title
    .replace(/[^a-zA-Z0-9-\P{ASCII}]/gu, "-")
    .replace(/-+/g, "-")
    .replace(/^-+|-+$/g, "");
}

async function listCommand(flags: Flags): Promise<void> {
  const projects = flags.all ? await allProjects() : [resolveProject(flags)];
  const tickets = (await Promise.all(projects.map((project) => loadTickets(project)))).flat();
  const filtered = flags.statuses.length > 0
    ? tickets.filter((ticket) => flags.statuses.includes(ticket.status))
    : tickets;
  if (flags.json) return output(filtered.map((ticket) => ticketJson(ticket, flags.all)));
  for (const ticket of filtered) {
    const project = flags.all ? `${ticket.project}\t` : "";
    console.log(`${project}${ticket.id}\t${ticket.status}\t${ticket.title}`);
  }
}

async function showCommand(positional: string[], flags: Flags): Promise<void> {
  const id = positional[0] ?? fail(USAGE);
  const ticket = resolveId(await loadTickets(resolveProject(flags)), id);
  if (flags.json) return output({ ...ticketJson(ticket, false), body: ticket.body });
  console.log(`${ticket.id}\nstatus: ${ticket.status}`);
  console.log("depends_on:");
  for (const dep of ticket.dependsOn) console.log(`  - ${dep}`);
  console.log(`\n# ${ticket.title}\n\n${ticket.body.trimEnd()}`);
}

async function statusCommand(positional: string[], flags: Flags): Promise<void> {
  const [id, status] = positional;
  if (!id || !status) fail(USAGE);
  const target = validateStatus(status);
  const ticket = resolveId(await loadTickets(resolveProject(flags)), id);
  const { frontmatter, rest } = splitFrontmatter(await readFile(ticket.path, "utf8"), ticket.path);
  await writeFile(ticket.path, mergeFrontmatter(frontmatter, { status: target }) + rest);
  console.log(target);
}

async function createCommand(positional: string[], flags: Flags): Promise<void> {
  const title = positional[0] ?? fail(USAGE);
  const slug = toSlug(title);
  if (!slug) fail(`cannot create slug from title: ${title}`);
  const status = flags.status !== undefined ? validateStatus(flags.status) : "open";
  const project = resolveProject(flags);
  const tickets = await loadTickets(project);
  const dependsOn = flags.dependsOn ?? [];
  const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
  const missing = dependsOn.filter((dep) => !byId.has(dep));
  if (missing.length > 0) fail(`depends_on references missing ticket(s): ${missing.join(", ")}`);
  if (status === "open") {
    const unresolved = dependsOn.filter((dep) => byId.get(dep)?.status !== "closed");
    if (unresolved.length > 0) {
      const detail = unresolved.map((dep) => `${dep} (${byId.get(dep)?.status ?? "missing"})`).join(", ");
      fail(`cannot create an open ticket: depends_on has unclosed ticket(s): ${detail}`);
    }
  }
  const takenTimestamps = new Set(tickets.map((ticket) => ticket.id.slice(0, ID_TIMESTAMP_LENGTH)));
  let date = new Date();
  while (takenTimestamps.has(timestamp(date))) date = new Date(date.getTime() + 1000);
  const id = `${timestamp(date)}_${slug}`;
  const path = join(storeRoot(), project, `${id}.md`);
  const frontmatter = [
    "---",
    `status: ${status}`,
    ...(dependsOn.length > 0 ? ["depends_on:", ...dependsOn.map((dep) => `  - ${dep}`)] : []),
    "---",
  ].join("\n");
  const body = flags.body !== undefined ? `# ${title}\n\n${flags.body}\n` : `# ${title}\n`;
  await writeFile(path, `${frontmatter}\n${body}`);
  if (flags.json) return output(ticketJson({ id, status, title, dependsOn, path, project }, false));
  console.log(id);
}

// --metadata keys map onto frontmatter; other keys are rejected.
function parseMetadata(raw: string | undefined): FrontmatterPatch {
  if (raw === undefined) return {};
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw);
  } catch {
    fail("--metadata is not valid JSON");
  }
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) fail("--metadata must be a JSON object");
  const patch: FrontmatterPatch = {};
  for (const [key, value] of Object.entries(parsed)) {
    if (key === "status") {
      if (typeof value !== "string") fail('metadata key "status" must be a string');
      patch.status = validateStatus(value);
    } else if (key === "depends_on") {
      if (!Array.isArray(value) || value.some((item) => typeof item !== "string")) {
        fail('metadata key "depends_on" must be an array of strings');
      }
      patch.dependsOn = value as string[];
    } else {
      fail(`unknown metadata key: ${key}`);
    }
  }
  return patch;
}

async function updateCommand(positional: string[], flags: Flags): Promise<void> {
  const id = positional[0] ?? fail(USAGE);
  if (flags.metadata === undefined && flags.body === undefined) fail(USAGE);
  const tickets = await loadTickets(resolveProject(flags));
  const ticket = resolveId(tickets, id);
  const patch = parseMetadata(flags.metadata);
  if (patch.status === "locked" && ticket.status === "locked") fail(`ticket is already locked: ${ticket.id}`);
  if (patch.dependsOn !== undefined) {
    const known = new Set(tickets.map((t) => t.id));
    const missing = patch.dependsOn.filter((dep) => !known.has(dep));
    if (missing.length > 0) fail(`depends_on references missing ticket(s): ${missing.join(", ")}`);
  }
  // Consistency checks run only when status or depends_on is touched; a body-only update is free of them.
  if (patch.status !== undefined || patch.dependsOn !== undefined) {
    const nextStatus = patch.status ?? ticket.status;
    const nextDeps = patch.dependsOn ?? ticket.dependsOn;
    if (nextStatus === "open") {
      const byId = new Map(tickets.map((t) => [t.id, t] as const));
      const unresolved = nextDeps.filter((dep) => byId.get(dep)?.status !== "closed");
      if (unresolved.length > 0) {
        const detail = unresolved.map((dep) => `${dep} (${byId.get(dep)?.status ?? "missing"})`).join(", ");
        fail(`cannot set status to open: depends_on has unclosed ticket(s): ${detail}`);
      }
    }
  }
  const { frontmatter, rest } = splitFrontmatter(await readFile(ticket.path, "utf8"), ticket.path);
  const newRest = flags.body !== undefined ? replaceBody(rest, flags.body) : rest;
  await writeFile(ticket.path, mergeFrontmatter(frontmatter, patch) + newRest);
  if (flags.json) {
    return output(ticketJson({ ...ticket, status: patch.status ?? ticket.status, dependsOn: patch.dependsOn ?? ticket.dependsOn }, false));
  }
  if (patch.status !== undefined) console.log(patch.status);
}

function findCycles(tickets: Ticket[]): string[][] {
  const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
  const state = new Map<string, number>();
  const stack: string[] = [];
  const cycles: string[][] = [];
  const seen = new Set<string>();
  const visit = (id: string): void => {
    const visited = state.get(id) ?? 0;
    if (visited === 2) return;
    if (visited === 1) {
      const cycle = stack.slice(stack.indexOf(id));
      const key = [...cycle].sort().join("|");
      if (!seen.has(key)) {
        seen.add(key);
        cycles.push(cycle);
      }
      return;
    }
    state.set(id, 1);
    stack.push(id);
    for (const dep of byId.get(id)?.dependsOn ?? []) {
      if (byId.has(dep)) visit(dep);
    }
    stack.pop();
    state.set(id, 2);
  };
  for (const ticket of tickets) visit(ticket.id);
  return cycles;
}

async function checkCommand(flags: Flags): Promise<void> {
  const projects = flags.all ? await allProjects() : [resolveProject(flags)];
  const issues: Issue[] = [];
  for (const project of projects) {
    const tickets = await loadTickets(project);
    const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
    for (const ticket of tickets) {
      const file = relative(storeRoot(), ticket.path);
      if (!STATUSES.includes(ticket.status as Status)) {
        issues.push({
          file,
          kind: "invalid-status",
          detail: `status "${ticket.status}" is not one of ${STATUSES.join(", ")}`,
        });
      }
      const missing = ticket.dependsOn.filter((dep) => !byId.has(dep));
      if (missing.length > 0) {
        issues.push({ file, kind: "missing-dep", detail: `depends_on references missing ticket(s): ${missing.join(", ")}` });
      }
      if (ticket.status === "open") {
        const unresolved = ticket.dependsOn.filter((dep) => byId.get(dep)?.status !== "closed");
        if (unresolved.length > 0) {
          const detail = unresolved.map((dep) => `${dep} (${byId.get(dep)?.status ?? "missing"})`).join(", ");
          issues.push({ file, kind: "open-with-unresolved-deps", detail: `status is open but depends_on has unclosed ticket(s): ${detail}` });
        }
      }
    }
    for (const cycle of findCycles(tickets)) {
      const head = byId.get(cycle[0]!)!;
      issues.push({ file: relative(storeRoot(), head.path), kind: "dep-cycle", detail: `depends_on cycle: ${cycle.join(" -> ")}` });
    }
  }
  if (flags.json) {
    output(issues);
    if (issues.length > 0) process.exit(1);
    return;
  }
  if (issues.length === 0) {
    console.log("ok");
    return;
  }
  for (const issue of issues) console.log(`${issue.file}: ${issue.kind}: ${issue.detail}`);
  process.exit(1);
}

async function main(): Promise<void> {
  const [command = "", ...argv] = process.argv.slice(2);
  const { flags, positional } = parseArgs(argv, command);
  switch (command) {
    case "list":
      return listCommand(flags);
    case "show":
      return showCommand(positional, flags);
    case "status":
      return statusCommand(positional, flags);
    case "create":
      return createCommand(positional, flags);
    case "update":
      return updateCommand(positional, flags);
    case "check":
      return checkCommand(flags);
    default:
      fail(USAGE);
  }
}

await main();
