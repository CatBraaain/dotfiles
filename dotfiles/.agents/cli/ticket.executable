#!/usr/bin/env bun
// ticket CLI — human/agent interface for the markdown ticket store.
// Spec: dotfiles/.agents/cli/ticket.spec.md

import { execFileSync } from "node:child_process";
import { mkdir, readdir, readFile, writeFile } from "node:fs/promises";
import { homedir } from "node:os";
import { basename, join, relative } from "node:path";

const STATUSES = ["draft", "open", "blocked", "locked", "closed", "cancelled"] as const;
type Status = (typeof STATUSES)[number];

const USAGE = `usage: ticket list [-s <s>[,<s>...]] [-p <project>] [-a] [--json]
       ticket show [<selector>] [-p <project>] [--json]
       ticket create <json> [-p <project>] [--json]
       ticket set [<selector>] <json> [-p <project>] [--json]
       ticket edit [<selector>] <old> <new> [-p <project>] [--json]
       ticket check [-p <project>] [-a] [--json]`;

interface Flags {
  project?: string;
  all: boolean;
  json: boolean;
  statuses: string[];
}

interface Ticket {
  id: string;
  status: string;
  after: string | null;
  title: string;
  path: string;
  project: string;
  body: string;
}

interface Issue {
  file: string;
  kind: "invalid-frontmatter" | "invalid-status" | "missing-after" | "after-cycle";
  detail: string;
}

type FrontmatterPatch = { status?: Status; after?: string | null };

const ALLOWED_FLAGS: Record<string, { all?: boolean; statuses?: boolean; json?: boolean }> = {
  list: { all: true, statuses: true, json: true },
  show: { json: true },
  create: { json: true },
  set: { json: true },
  edit: { json: true },
  check: { all: true, json: true },
};

const storeRoot = () => join(homedir(), ".agents", "tickets");

function fail(message: string): never {
  console.error(message);
  process.exit(1);
}

function usageFail(): never {
  console.error(USAGE);
  process.exit(2);
}

function output(value: unknown): void {
  console.log(JSON.stringify(value, null, 2));
}

function parseArgs(argv: string[], command: string): { flags: Flags; positional: string[] } {
  const allowed = ALLOWED_FLAGS[command];
  if (!allowed) usageFail();
  const flags: Flags = { all: false, json: false, statuses: [] };
  const positional: string[] = [];
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i]!;
    const value = () => argv[++i] ?? usageFail();
    if (arg === "-p" || arg === "--project") flags.project = value();
    else if (arg === "-a" || arg === "--all") {
      if (!allowed.all) usageFail();
      flags.all = true;
    } else if (arg === "-s" || arg === "--status") {
      if (!allowed.statuses) usageFail();
      flags.statuses = value().split(",");
    } else if (arg === "--json") {
      if (!allowed.json) usageFail();
      flags.json = true;
    } else if (arg.startsWith("-")) usageFail();
    else positional.push(arg);
  }
  return { flags, positional };
}

function validateStatus(status: string): Status {
  if (!(STATUSES as readonly string[]).includes(status)) {
    fail(`invalid status "${status}" (one of: ${STATUSES.join(", ")})`);
  }
  return status as Status;
}

// Returns the error detail when frontmatter is missing, unclosed, or has no status field.
function frontmatterIssue(content: string): string | null {
  if (!content.startsWith("---\n")) return "no frontmatter";
  const closing = content.indexOf("\n---\n", 4);
  if (closing < 0) return "unclosed frontmatter";
  if (!/^status:.*$/m.test(content.slice(4, closing))) return "no status field";
  return null;
}

// Splits a well-formed file (frontmatterIssue(content) must return null first).
// `rest` starts with the closing "\n---\n".
function splitFrontmatter(content: string): { frontmatter: string; fields: Map<string, string>; rest: string } {
  const closing = content.indexOf("\n---\n", 4);
  const frontmatter = content.slice(0, closing);
  const fields = new Map<string, string>();
  for (const line of frontmatter.slice(4).split("\n")) {
    const pair = line.match(/^([A-Za-z_-]+):\s*(.*)$/);
    if (pair) fields.set(pair[1]!, pair[2]!.trim());
  }
  return { frontmatter, fields, rest: content.slice(closing) };
}

// Without `collect`, broken files fail the load (exit 1); with it, check collects
// issues for them and skips the files instead.
async function loadTickets(project: string, collect?: Issue[]): Promise<Ticket[]> {
  const dir = join(storeRoot(), project);
  let ids: string[];
  try {
    ids = (await readdir(dir))
      .filter((name) => name.endsWith(".md"))
      .map((name) => name.slice(0, -3))
      .sort();
  } catch {
    fail(`project not found: ${dir}`);
  }
  const tickets: Ticket[] = [];
  for (const id of ids!) {
    const path = join(dir, `${id}.md`);
    const file = relative(storeRoot(), path);
    const content = await readFile(path, "utf8");
    const broken = frontmatterIssue(content);
    if (broken) {
      if (collect) {
        collect.push({ file, kind: "invalid-frontmatter", detail: broken });
        continue;
      }
      fail(`${file}: ${broken}`);
    }
    const { fields, rest } = splitFrontmatter(content);
    const status = fields.get("status") ?? "";
    if (!(STATUSES as readonly string[]).includes(status)) {
      const detail = `status "${status}" is not one of ${STATUSES.join(", ")}`;
      if (collect) {
        collect.push({ file, kind: "invalid-status", detail });
        continue;
      }
      fail(`${file}: ${detail}`);
    }
    const body = rest.slice("\n---\n".length);
    tickets.push({
      id,
      status,
      after: fields.get("after") || null,
      title: body.match(/^# (.+)$/m)?.[1]?.trim() ?? id,
      path,
      project,
      body,
    });
  }
  return tickets;
}

async function allProjects(): Promise<string[]> {
  try {
    const entries = await readdir(storeRoot(), { withFileTypes: true });
    return entries.filter((entry) => entry.isDirectory()).map((entry) => entry.name).sort();
  } catch {
    return fail(`ticket store not found: ${storeRoot()}`);
  }
}

function isActionable(ticket: Ticket, byId: Map<string, Ticket>): boolean {
  if (ticket.status !== "open") return false;
  if (ticket.after === null) return true;
  return byId.get(ticket.after)?.status === "closed";
}

function resolveSelector(tickets: Ticket[], selector: string | undefined): Ticket {
  if (selector === "") usageFail();
  if (selector === undefined || selector === "next") {
    const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
    const first = tickets.find((ticket) => isActionable(ticket, byId));
    if (!first) fail("no actionable ticket");
    return first;
  }
  const exact = tickets.find((ticket) => ticket.id === selector);
  if (exact) return exact;
  const matches = tickets.filter((ticket) => ticket.id.startsWith(selector));
  if (matches.length === 1) return matches[0]!;
  if (matches.length > 1) {
    fail(`ambiguous id "${selector}":\n${matches.map((ticket) => `  ${ticket.id}`).join("\n")}`);
  }
  fail(`ticket not found: ${selector}`);
}

function ticketJson(ticket: Ticket, withProject: boolean): Record<string, unknown> {
  const json: Record<string, unknown> = {
    id: ticket.id,
    status: ticket.status,
    after: ticket.after,
    title: ticket.title,
    path: ticket.path,
  };
  if (withProject) json.project = ticket.project;
  return json;
}

// git worktree list lists the main worktree first; fall back to the cwd name
// when cwd is not inside a git repo or git is unavailable.
function defaultProject(): string {
  const cwd = process.cwd();
  try {
    const porcelain = execFileSync("git", ["worktree", "list", "--porcelain"], {
      cwd,
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    });
    const mainPath = porcelain.match(/^worktree (.+)$/m)?.[1];
    if (mainPath !== undefined) return basename(mainPath.trim());
  } catch {
    // fall through to the cwd name
  }
  return basename(cwd);
}

function resolveProject(flags: Flags): string {
  return flags.project ?? defaultProject();
}

function timestamp(date: Date): string {
  const pad = (value: number) => String(value).padStart(2, "0");
  return `${date.getFullYear()}${pad(date.getMonth() + 1)}${pad(date.getDate())}-${pad(date.getHours())}${pad(date.getMinutes())}${pad(date.getSeconds())}`;
}

function parseJsonObject(raw: string): Record<string, unknown> {
  let parsed: unknown;
  try {
    parsed = JSON.parse(raw);
  } catch {
    usageFail();
  }
  if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) usageFail();
  return parsed as Record<string, unknown>;
}

// Overwrites status/after lines in place; `after: null` removes the line.
// splitFrontmatter(content) must have validated the status line exists.
function mergeFrontmatter(frontmatter: string, patch: FrontmatterPatch): string {
  const lines = frontmatter.split("\n");
  const statusIndex = lines.findIndex((line) => line.startsWith("status:"));
  if (patch.status !== undefined) lines[statusIndex] = `status: ${patch.status}`;
  if (patch.after !== undefined) {
    const afterIndex = lines.findIndex((line) => line.startsWith("after:"));
    if (patch.after === null) {
      if (afterIndex >= 0) lines.splice(afterIndex, 1);
    } else if (afterIndex >= 0) {
      lines.splice(afterIndex, 1, `after: ${patch.after}`);
    } else {
      lines.splice(statusIndex + 1, 0, `after: ${patch.after}`);
    }
  }
  return lines.join("\n");
}

// Walks the after chain from `after`; a loop back to `targetId` is a cycle.
function createsCycle(targetId: string, after: string, byId: Map<string, Ticket>): boolean {
  let current: string | null = after;
  for (let steps = 0; current !== null && steps <= byId.size; steps++) {
    if (current === targetId) return true;
    current = byId.get(current)?.after ?? null;
  }
  return false;
}

// Status to write: the explicit value wins; otherwise linkage only runs when
// after is touched — setting an unresolved after blocks, releasing one from
// blocked reopens, and releasing from a non-blocked status keeps it.
function linkedStatus(target: Ticket, patch: FrontmatterPatch): Status {
  if (patch.status !== undefined) return patch.status;
  if (patch.after === undefined) return target.status as Status;
  if (patch.after !== null) return "blocked";
  return target.status === "blocked" ? "open" : target.status as Status;
}

async function listCommand(flags: Flags): Promise<void> {
  for (const status of flags.statuses) validateStatus(status);
  const projects = flags.all ? await allProjects() : [resolveProject(flags)];
  const tickets = (await Promise.all(projects.map((project) => loadTickets(project)))).flat();
  const filtered = flags.statuses.length > 0
    ? tickets.filter((ticket) => flags.statuses.includes(ticket.status))
    : tickets.filter((ticket) => ticket.status === "open");
  if (flags.json) return output(filtered.map((ticket) => ticketJson(ticket, flags.all)));
  for (const ticket of filtered) {
    const project = flags.all ? `${ticket.project}\t` : "";
    console.log(`${project}${ticket.id}\t${ticket.status}\t${ticket.title}`);
  }
}

async function showCommand(positional: string[], flags: Flags): Promise<void> {
  if (positional.length > 1) usageFail();
  const ticket = resolveSelector(await loadTickets(resolveProject(flags)), positional[0]);
  if (flags.json) return output({ ...ticketJson(ticket, false), body: ticket.body });
  console.log(`${ticket.id}\nstatus: ${ticket.status}\nafter: ${ticket.after ?? "-"}\n`);
  console.log(ticket.body.trimEnd());
}

interface CreateInput {
  title: string;
  status?: Status;
  after?: string | null;
  body?: string;
}

function parseCreateInput(raw: string | undefined): CreateInput {
  if (raw === undefined) usageFail();
  const parsed = parseJsonObject(raw);
  if (typeof parsed.title !== "string") usageFail();
  const input: CreateInput = { title: parsed.title };
  if (parsed.status !== undefined) {
    if (typeof parsed.status !== "string") usageFail();
    input.status = validateStatus(parsed.status);
  }
  if (parsed.after !== undefined) {
    if (parsed.after !== null && typeof parsed.after !== "string") usageFail();
    input.after = parsed.after;
  }
  if (parsed.body !== undefined) {
    if (typeof parsed.body !== "string") usageFail();
    input.body = parsed.body;
  }
  return input;
}

// after targets: allowed after statuses are draft/open/locked/blocked, which are
// all unresolved; closed/cancelled are rejected.
async function createCommand(positional: string[], flags: Flags): Promise<void> {
  if (positional.length !== 1) usageFail();
  const input = parseCreateInput(positional[0]);
  const project = resolveProject(flags);
  const projectDir = join(storeRoot(), project);
  await mkdir(projectDir, { recursive: true });
  const tickets = await loadTickets(project);
  const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
  let after: string | null = null;
  if (input.after !== undefined && input.after !== null) {
    const target = byId.get(input.after);
    if (!target) fail(`after references missing ticket: ${input.after}`);
    if (target.status === "closed") fail(`after references closed ticket: ${input.after}`);
    if (target.status === "cancelled") fail(`after references cancelled ticket: ${input.after}`);
    after = input.after;
  }
  const status: Status = input.status ?? (after !== null ? "blocked" : "open");
  const taken = new Set(tickets.map((ticket) => ticket.id));
  let date = new Date();
  while (taken.has(timestamp(date))) date = new Date(date.getTime() + 1000);
  const id = timestamp(date);
  const path = join(storeRoot(), project, `${id}.md`);
  const frontmatter = ["---", `status: ${status}`, ...(after !== null ? [`after: ${after}`] : []), "---"].join("\n");
  const body = input.body !== undefined ? `# ${input.title}\n\n${input.body}\n` : `# ${input.title}\n`;
  await writeFile(path, `${frontmatter}\n${body}`);
  const ticket: Ticket = { id, status, after, title: input.title, path, project, body };
  if (flags.json) return output(ticketJson(ticket, false));
  console.log(id);
}

function parseSetInput(raw: string | undefined): FrontmatterPatch {
  if (raw === undefined) usageFail();
  const parsed = parseJsonObject(raw);
  const patch: FrontmatterPatch = {};
  const keys = Object.keys(parsed);
  if (keys.length === 0) usageFail();
  for (const key of keys) {
    if (key === "status") {
      if (typeof parsed.status !== "string") usageFail();
      patch.status = validateStatus(parsed.status);
    } else if (key === "after") {
      if (parsed.after !== null && typeof parsed.after !== "string") usageFail();
      patch.after = parsed.after;
    } else {
      usageFail();
    }
  }
  return patch;
}

async function setCommand(positional: string[], flags: Flags): Promise<void> {
  if (positional.length < 1 || positional.length > 2) usageFail();
  const [selector, jsonArg] = positional.length === 1 ? [undefined, positional[0]!] : [positional[0]!, positional[1]!];
  const patch = parseSetInput(jsonArg);
  const tickets = await loadTickets(resolveProject(flags));
  const target = resolveSelector(tickets, selector);
  const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
  if (patch.after !== undefined && patch.after !== null) {
    const dep = byId.get(patch.after);
    if (!dep) fail(`after references missing ticket: ${patch.after}`);
    if (dep.status === "closed") fail(`after references closed ticket: ${patch.after}`);
    if (dep.status === "cancelled") fail(`after references cancelled ticket: ${patch.after}`);
    if (createsCycle(target.id, patch.after, byId)) {
      fail(`setting after would create a cycle: ${target.id} -> ${patch.after}`);
    }
  }
  const nextStatus = linkedStatus(target, patch);
  const { frontmatter, rest } = splitFrontmatter(await readFile(target.path, "utf8"));
  await writeFile(target.path, mergeFrontmatter(frontmatter, { status: nextStatus, after: patch.after }) + rest);
  if (patch.status === "closed") {
    // Release blocked tickets that wait on the target.
    for (const ticket of tickets) {
      if (ticket.id === target.id || ticket.status !== "blocked" || ticket.after !== target.id) continue;
      const parts = splitFrontmatter(await readFile(ticket.path, "utf8"));
      await writeFile(ticket.path, mergeFrontmatter(parts.frontmatter, { status: "open" }) + parts.rest);
    }
  }
  const updated: Ticket = {
    ...target,
    status: nextStatus,
    after: patch.after !== undefined ? patch.after : target.after,
  };
  if (flags.json) return output(ticketJson(updated, false));
  if (patch.status !== undefined) console.log(patch.status);
  else if (patch.after !== undefined) {
    // after-only: linkage rewrote the status unless it kept it as a non-blocked value
    if (patch.after !== null || target.status === "blocked") console.log(nextStatus);
  }
}

async function editCommand(positional: string[], flags: Flags): Promise<void> {
  if (positional.length < 2 || positional.length > 3) usageFail();
  // 2 args: [old, new] (selector defaults to next); 3 args: [selector, old, new].
  const [selector, old, replacement] = positional.length === 2
    ? [undefined, positional[0]!, positional[1]!]
    : [positional[0]!, positional[1]!, positional[2]!];
  if (!old || replacement === undefined) usageFail();
  const project = resolveProject(flags);
  const tickets = await loadTickets(project);
  const target = resolveSelector(tickets, selector);
  const { frontmatter, rest } = splitFrontmatter(await readFile(target.path, "utf8"));
  const body = rest.slice("\n---\n".length);
  const count = body.split(old).length - 1;
  if (count !== 1) fail(`${target.id}: "${old}" appears ${count} times in the body`);
  const updatedBody = body.replace(old, replacement);
  await writeFile(target.path, `${frontmatter}\n---\n${updatedBody}`);
  if (flags.json) {
    const title = updatedBody.match(/^# (.+)$/m)?.[1]?.trim() ?? target.id;
    return output(ticketJson({ ...target, title }, false));
  }
}

// Follows after chains (one per ticket) and reports each cycle once.
function findCycles(tickets: Ticket[]): string[][] {
  const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
  const state = new Map<string, number>();
  const stack: string[] = [];
  const cycles: string[][] = [];
  const seen = new Set<string>();
  const visit = (id: string): void => {
    const visited = state.get(id) ?? 0;
    if (visited === 2) return;
    if (visited === 1) {
      const cycle = stack.slice(stack.indexOf(id));
      const key = [...cycle].sort().join("|");
      if (!seen.has(key)) {
        seen.add(key);
        cycles.push(cycle);
      }
      return;
    }
    state.set(id, 1);
    stack.push(id);
    const after = byId.get(id)?.after;
    if (after !== null && after !== undefined && byId.has(after)) visit(after);
    stack.pop();
    state.set(id, 2);
  };
  for (const ticket of tickets) visit(ticket.id);
  return cycles;
}

async function checkCommand(flags: Flags): Promise<void> {
  const projects = flags.all ? await allProjects() : [resolveProject(flags)];
  const issues: Issue[] = [];
  for (const project of projects) {
    const tickets = await loadTickets(project, issues);
    const byId = new Map(tickets.map((ticket) => [ticket.id, ticket] as const));
    for (const ticket of tickets) {
      if (ticket.after !== null && !byId.has(ticket.after)) {
        issues.push({
          file: relative(storeRoot(), ticket.path),
          kind: "missing-after",
          detail: `after references missing ticket: ${ticket.after}`,
        });
      }
    }
    for (const cycle of findCycles(tickets)) {
      const head = byId.get(cycle[0]!)!;
      issues.push({
        file: relative(storeRoot(), head.path),
        kind: "after-cycle",
        detail: `after cycle: ${cycle.join(" -> ")}`,
      });
    }
  }
  if (flags.json) {
    output(issues);
    if (issues.length > 0) process.exit(1);
    return;
  }
  if (issues.length === 0) {
    console.log("ok");
    return;
  }
  for (const issue of issues) console.log(`${issue.file}: ${issue.kind}: ${issue.detail}`);
  process.exit(1);
}

async function main(): Promise<void> {
  const [command = "", ...argv] = process.argv.slice(2);
  const { flags, positional } = parseArgs(argv, command);
  switch (command) {
    case "list":
      return listCommand(flags);
    case "show":
      return showCommand(positional, flags);
    case "create":
      return createCommand(positional, flags);
    case "set":
      return setCommand(positional, flags);
    case "edit":
      return editCommand(positional, flags);
    case "check":
      return checkCommand(flags);
    default:
      usageFail();
  }
}

await main();
