#!/usr/bin/env bash
# Background tasks primed once at harness startup. pi and dsh both run this
# script detached, so every task must tolerate running twice: deja serializes
# index builds with its own cross-process lock, pi update deduplicates
# overlapping runs with flock, and the resident servers are spawned only when
# their health check fails (a second spawn loses a port race and exits, which
# is harmless).

# deja index: fresh -> no-op, stale -> incremental build.
command -v deja >/dev/null 2>&1 && deja index >/dev/null 2>&1 &

# --- pi update: refresh pi / extensions, one run at a time -------------------
# pi update has no throttle of its own, so every launch offers to run it; the
# lock file (in ${TMPDIR:-/tmp}) deduplicates overlapping runs. flock -n
# skips a launch while another update is in flight, and the detached pi
# update inherits fd 9 so the lock is held until that update exits.
update_lock="${TMPDIR:-/tmp}/pi-update.lock"
if command -v pi >/dev/null 2>&1 && command -v flock >/dev/null 2>&1 \
	&& exec 9>"$update_lock" && flock -n 9; then
	nohup pi update --all >/dev/null 2>&1 &
fi

# url_authority URL -> the host:port authority (scheme and path stripped).
url_authority() {
	local rest="$1"
	rest="${rest#*://}"
	rest="${rest%%/*}"
	printf '%s\n' "$rest"
}

# port_open HOST PORT: succeed when a TCP connection is accepted.
port_open() {
	(exec 3<>"/dev/tcp/$1/$2") 2>/dev/null
}

# --- camoufox server: rendering backend shared by pi and dsh web-search -----
# `browse server start` is idempotent: it no-ops when the server is healthy and
# otherwise spawns it (maintaining Xvfb/x11vnc on Linux, appending to the
# log) and waits for readiness. This script only gates the spawn on the port
# check so a healthy server costs nothing.
camoufox_authority="$(url_authority "${CAMOUFOX_BASE_URL:-ws://127.0.0.1:9378/camoufox}")"
if [ -n "$camoufox_authority" ]; then
	camoufox_host="${camoufox_authority%:*}"
	camoufox_port="${camoufox_authority##*:}"
	if ! port_open "$camoufox_host" "$camoufox_port"; then
		camoufox_cli="$HOME/.agents/cli/browse"
		[ -f "$camoufox_cli" ] || camoufox_cli="$camoufox_cli.executable"
		log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/pi/web-search"
		if [ -f "$camoufox_cli" ] && command -v bun >/dev/null 2>&1; then
			mkdir -p "$log_dir"
			nohup bun "$camoufox_cli" server start >>"$log_dir/camoufox-server.log" 2>&1 &
		fi
	fi
fi

# --- openserp: SERP parsing backend -----------------------------------------
openserp_url="${OPENSERP_BASE_URL:-http://127.0.0.1:7000}"
if command -v openserp >/dev/null 2>&1; then
	if ! curl -fsS --max-time 1 "$openserp_url/ready" >/dev/null 2>&1; then
		openserp_authority="$(url_authority "$openserp_url")"
		nohup openserp serve -a "${openserp_authority%:*}" -p "${openserp_authority##*:}" --quiet >/dev/null 2>&1 &
	fi
fi

exit 0
