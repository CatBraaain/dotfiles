// https://pi.dev/docs/latest/settings
{
  "theme": "dark",
  "defaultThinkingLevel": "high",
  "defaultProjectTrust": "always",
  "externalEditor": "code --wait",
  "quietStartup": false,
  "compaction": {
    "keepRecentTokens": 50000 // default: 20000
  },
  // default: 300000. Raise so a silent (>5 min) thinking phase on junior-tier
  // models is not aborted with "Request aborted" mid-stream.
  "httpIdleTimeoutMs": 600000,
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 0,
    "provider": {
      "maxRetries": 0
    }
  },
  "enabledModels": [
    // "**",
    "zai/**",
    "openai-codex/**",
    "commandcode/**",
    "openrouter/**/*:free"
  ],
  "packages": [
    "npm:pi-commandcode-provider",
    "npm:pi-cursor-sdk",
    "npm:@entelligentsia/pi-claude-compat",
    "npm:@narumitw/pi-stamp",
    "npm:@narumitw/pi-usage"
  ]
}
