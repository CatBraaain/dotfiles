// https://pi.dev/docs/latest/settings
{
  "theme": "dark",
  "defaultThinkingLevel": "high",
  "defaultProjectTrust": "always",
  "externalEditor": "code --wait",
  "quietStartup": false,
  "compaction": {
    "keepRecentTokens": 50000 // default: 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 0,
    "provider": {
      "maxRetries": 0
    }
  },
  "enabledModels": [
    // "**",
    "zai/**",
    "openai-codex/**",
    "commandcode/**",
    "openrouter/**/*:free"
  ],
  "packages": [
    "npm:pi-commandcode-provider",
    "npm:pi-cursor-sdk",
    "npm:@entelligentsia/pi-claude-compat",
    "npm:@narumitw/pi-stamp",
    "npm:@narumitw/pi-usage",
    {
