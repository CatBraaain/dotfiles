// https://pi.dev/docs/latest/settings
{
  "theme": "purple-dark",
  "tuiMode": "fullscreen",
  "fullscreenWheelScrollLines": 5,
  "defaultThinkingLevel": "max",
  "defaultProjectTrust": "always",
  "externalEditor": "code --wait",
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "steeringMode": "all",
  "followUpMode": "all",
  "treeFilterMode": "user-only",
  "branchSummary": {
    "skipPrompt": true
  },
  "compaction": {
    "enabled": false,
    "keepRecentTokens": 50000 // default: 20000
  },
  // default: 300000. Raise so a silent (>5 min) thinking phase on junior-class
  // models is not aborted with "Request aborted" mid-stream.
  "httpIdleTimeoutMs": 600000,
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 0,
    "provider": {
      "maxRetries": 0
    }
  },
  "enabledModels": [
    // "**",
    "zai/**",
    "openai-codex/**",
    "commandcode/**",
    "openrouter/**/*:free"
  ],
  "extensions": ["extensions/tmux-handoff", "-builtin:codemode"],
  "packages": ["npm:@narumitw/pi-stamp"]
}
