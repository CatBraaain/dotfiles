{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/refs/heads/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "~/.pi/agent/auth.json": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "git push *": "ask",
      "git commit *": "ask",
      "git reset --hard *": "deny",
      "git clean *": "ask",
      "git rebase *": "ask",
      "git branch -D *": "ask",
      "gh *": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/projects/*": "allow"
    }
  }
}
