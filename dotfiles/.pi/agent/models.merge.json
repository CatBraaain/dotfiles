// https://pi.dev/docs/latest/models
// OpenRouter が配るメタデータの不成立な値（maxTokens >= contextWindow 等）を
// 実態に合わせて上書きする。根拠:
// - https://github.com/earendil-works/pi/issues/3061 （メタデータの矛盾）
// - https://github.com/earendil-works/pi/issues/8061 （出力予約が予算計算に反映されず 400）
{
  "providers": {
    "openrouter": {
      "modelOverrides": {
        "z-ai/glm-5.2:free": {
          "contextWindow": 256000,
          "maxTokens": 32768
        },
        "dots-studio/dots-3-note-preview:free": {
          "contextWindow": 512000,
          "maxTokens": 32768
        }
      }
    }
  }
}
