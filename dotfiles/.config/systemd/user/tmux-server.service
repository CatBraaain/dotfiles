[Unit]
Description=Dedicated tmux server for pi

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=pi-tmux
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/home/linuxbrew/.linuxbrew/bin/tmux -S %t/pi-tmux/server.sock -f %h/.pi/agent/extensions/tmux-handoff/tmux.conf start-server
ExecStop=/home/linuxbrew/.linuxbrew/bin/tmux -S %t/pi-tmux/server.sock kill-server

[Install]
WantedBy=default.target
