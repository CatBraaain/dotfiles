async function main(): Promise<void> {
  const { buildHookContext } = await import(
    `${process.env.DOTFILES_MANAGER_SRC}/hook-context.ts`,
  );
  const { transform } = await buildHookContext();

  // User dictionary entries. Each entry is [phrase, reading] and becomes the
  // TSV row `phrase|1851 1851<TAB>reading<TAB>1`, matching existing entries.
  const dictionaryEntries: Array<[string, string]> = [
    ["単語", "たんご"],
    ["最高", "さいこう"],
    ["検証", "けんしょう"],
  ];
  const dictionaryRows = dictionaryEntries
    .map(([phrase, reading]) => `${phrase}|1851 1851\t${reading}\t1`)
    .join("\n");

  await transform("kagiroi.custom.dict.yaml", (content: string) => `${content}${dictionaryRows}\n`);
}

if (import.meta.main) await main();
