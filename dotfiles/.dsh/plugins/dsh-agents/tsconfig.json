{
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@deepseek-ai/*": [
        "/home/username/.bun/install/global/node_modules/@deepseek-ai/*"
      ],
      "yaml": [
        "/home/username/.bun/install/global/node_modules/yaml"
      ]
    }
  },
  "include": ["src"]
}
