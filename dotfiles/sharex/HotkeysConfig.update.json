{
  "Hotkeys.$merge": [
    {
      "match": {
        "TaskSettings": {
          "AfterCaptureJob": "CopyImageToClipboard, SaveImageToFile, UploadImageToHost"
        }
      },
      "merge": {
        "TaskSettings": {
          "AfterCaptureJob": "CopyImageToClipboard, SaveImageToFile"
        }
      }
    },
    {
      "match": {
        "TaskSettings": {
          "AfterUploadJob": "CopyURLToClipboard"
        }
      },
      "merge": {
        "TaskSettings": {
          "AfterUploadJob": "None"
        }
      }
    },
    {
      "match": {
        "HotkeyInfo": {
          "Hotkey": "PrintScreen"
        },
        "TaskSettings": {
          "Job": "RectangleRegion"
        }
      },
      "merge": {
        "HotkeyInfo": {
          "Hotkey": "None"
        }
      }
    },
    {
      "match": {
        "HotkeyInfo": {
          "Hotkey": "PrintScreen"
        },
        "TaskSettings": {
          "Job": "ScreenRecorder"
        }
      },
      "merge": {
        "HotkeyInfo": {
          "Hotkey": "None"
        }
      }
    },
    {
      "match": {
        "HotkeyInfo": {
          "Hotkey": "PrintScreen"
        },
        "TaskSettings": {
          "Job": "ScreenRecorderGIF"
        }
      },
      "merge": {
        "HotkeyInfo": {
          "Hotkey": "None"
        }
      }
    },
    {
      "match": {
        "HotkeyInfo": {
          "Hotkey": "PrintScreen"
        },
        "TaskSettings": {
          "Job": "PrintScreen"
        }
      },
      "merge": {
        "HotkeyInfo": {
          "Hotkey": "None"
        }
      }
    }
  ]
}
