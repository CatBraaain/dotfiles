// Appends the machine-specific layer to .gitconfig (spec: SPEC.md
// §build: ローカルフック). Machine values are written directly in this hook
// file; copy the .sample to dotfiles/.gitconfig.build.ts (gitignored) and
// edit per machine.
// @ts-ignore Bun provides Node built-ins at runtime; this repo has no Node type package.
import { readFile, writeFile } from "node:fs/promises";

export default async function build(context: {
  resolvePaths(path: string): { distPath: string; homePath: string };
}): Promise<void> {
  const { distPath } = context.resolvePaths(".gitconfig");
  const base = await readFile(distPath, "utf8");
  const machine = `
[user]
name = USERNAME
email = xxxxxxxxxx+USERNAME@users.noreply.github.com # https://github.com/settings/emails
`;
  const separator = base === "" || base.endsWith("\n") ? "" : "\n";
  await writeFile(distPath, base + separator + machine);
}
